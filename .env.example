TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token
KINOSIS_REGION=KR
KINOSIS_LANGUAGE=ko-KR

# Optional: exact Korean daily box-office ranks from KOBIS.
# If omitted, KINOSIS shows an unranked '현재 상영작' shelf instead of inventing a box-office rank.
KOBIS_API_KEY=your_kobis_api_key

# Supabase public values used by the health function and account-deletion verifier.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# SERVER ONLY. Required only for Settings > 계정 삭제.
# Never put this value in index.html, config.js, GitHub source, or browser code.
SUPABASE_SECRET_KEY=sb_secret_xxx
