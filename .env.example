TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token
KINOSIS_REGION=KR
KINOSIS_LANGUAGE=ko-KR

# Optional: exact Korean daily box-office ranks from KOBIS.
# If omitted, KINOSIS shows an unranked '현재 상영작' shelf instead of inventing a box-office rank.
KOBIS_API_KEY=your_kobis_api_key

# Optional overrides for the Netlify scheduled Supabase health function.
# These are public client values, not service-role credentials.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
