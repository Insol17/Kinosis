# Server/build only. Used by Netlify Functions and build-time snapshot hydration.
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token
KINOSIS_REGION=KR
KINOSIS_LANGUAGE=ko-KR

# Server/build only. KOBIS is ingested into a daily KR theatrical snapshot;
# browser refreshes never consume this key directly.
KOBIS_API_KEY=your_kobis_api_key

# Supabase public values used by Auth/cloud state.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# SERVER ONLY. Required only for Settings > 계정 삭제.
SUPABASE_SECRET_KEY=sb_secret_xxx
